{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dog-detection-response.schema.json",
  "title": "Dog Detection Response",
  "description": "The result of detecting dogs in one image.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "detections"],
  "properties": {
    "image": {
      "$ref": "#/definitions/image"
    },
    "detections": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/definitions/dogDetection"
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dogDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classId", "label", "confidence", "box", "breedPredictions"],
      "properties": {
        "classId": {
          "type": "integer",
          "const": 16
        },
        "label": {
          "type": "string",
          "const": "dog"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "box": {
          "$ref": "#/definitions/detectionBox"
        },
        "breedPredictions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/breedPrediction"
          }
        }
      }
    },
    "breedPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classId", "label", "confidence"],
      "properties": {
        "classId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 129
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "detectionBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0
        },
        "y1": {
          "type": "number",
          "minimum": 0
        },
        "x2": {
          "type": "number",
          "minimum": 0
        },
        "y2": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
