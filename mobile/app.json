{
  "expo": {
    "name": "WanChan Beam",
    "slug": "wanchan-beam",
    "platforms": ["ios", "android"],
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/logo/logo.png",
    "scheme": "wanchanbeam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinosoldic.wanchanbeam",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow WanChan Beam to use your camera to identify dogs."
      }
    },
    "android": {
      "package": "com.dinosoldic.wanchanbeam",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/adaptive-icon.png",
        "monochromeImage": "./assets/logo/monochrome-icon.png",
        "backgroundColor": "#FFF8EE"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "image": "./assets/logo/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-font",
      "./plugins/withAndroidNativeBuildFixes"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
