    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
