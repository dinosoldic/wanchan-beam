{
  "expo": {
    "name": "WanChan Beam",
    "slug": "wanchan-beam",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wanchanbeam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinosoldic.wanchanbeam"
    },
    "android": {
      "package": "com.dinosoldic.wanchanbeam",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
